{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "smart-inventory-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {"builder": "@angular-devkit/build-angular:application", "options": {"outputPath": "dist/smart-inventory-ui", "index": "src/index.html", "browser": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"]}, "configurations": {"production": {"optimization": true, "outputHashing": "all", "budgets": [{"type":"initial","maximumWarning":"1.5mb","maximumError":"2mb"}]}, "development": {"optimization": false, "extractLicenses": false, "sourceMap": true}}, "defaultConfiguration": "production"},
        "serve": {"builder": "@angular-devkit/build-angular:dev-server", "configurations": {"production": {"buildTarget":"smart-inventory-ui:build:production"}, "development": {"buildTarget":"smart-inventory-ui:build:development"}}, "defaultConfiguration":"development"},
        "test": {"builder":"@angular-devkit/build-angular:karma","options":{"polyfills":["zone.js","zone.js/testing"],"tsConfig":"tsconfig.spec.json","styles":["src/styles.css"],"karmaConfig":"karma.conf.cjs"}}
      }
    }
  },
  "cli": {
    "analytics": "a7aae727-1e36-4717-936c-9d4bbe41cb0a"
  }
}
